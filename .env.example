# PostgreSQL (used by Docker Compose and the API)
POSTGRES_DB=dealership
POSTGRES_USER=dealership
POSTGRES_PASSWORD=1234
POSTGRES_PORT=5433
ConnectionStrings__Default=Host=localhost;Port=5432;Database=dealership;Username=dealership;Password=1234

# Development-only seed. Never use this password outside local development.
SeedAdmin__Email=admin@concesionaria.local
SeedAdmin__Password=1234
SeedRolePassword=1234
SeedInventoryEmail=inventory@concesionaria.local
SeedManagerEmail=manager@concesionaria.local
SeedSalesEmail=sales@concesionaria.local

# JWT values must be replaced with a 32+ character secret outside development.
Jwt__Issuer=Dealership.Api
Jwt__Audience=Dealership.Frontend
Jwt__SigningKey=replace-with-a-development-secret-of-at-least-32-characters

# Next.js server-side API URL. Browser code always talks to route handlers.
BACKEND_URL=http://localhost:5080
NEXT_PUBLIC_API_BASE_URL=/api
AUTH_COOKIE_SECURE=false
